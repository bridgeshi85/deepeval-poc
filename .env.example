# LLM Configuration
LLM_MODEL=qwen2.5:latest
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text:latest

# Chroma Configuration
PERSIST_DIRECTORY=./chroma_db
KNOWLEDGE_BASE_PATH=./data/mcp_basics.txt
RETRIEVER_TOP_K=3
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Generation Configuration
TEMPERATURE=0.3
MAX_TOKENS=300

# DeepEval Configuration (for cloud features)
DEEPEVAL_MODEL=gpt-4
DEEPEVAL_API_KEY=your_api_key_here

# RAGAS Configuration
RAGAS_MODEL=gpt-4
RAGAS_API_KEY=your_api_key_here
